// api/mercadopago-criar-pix.js
// Este arquivo É o seu back-end: ele roda no servidor da Vercel (nunca no navegador do
// cliente), então é o lugar certo pra guardar o Access Token e chamar a API do Mercado Pago.
// Quando o cliente clica em "Pagar com Pix" no index.html, o navegador dele chama esta
// função (fetch('/api/mercadopago-criar-pix')), e é ESTA função que fala com o Mercado Pago.
//
// Cria uma "order" Pix de R$19,90 usando a API nova do Mercado Pago (Orders API) e devolve
// o QR Code (imagem em base64) e o código "copia e cola" pro front-end mostrar ao cliente.
//
// Variável de ambiente necessária (configurar no painel da Vercel):
//   MP_ACCESS_TOKEN -> Access Token do Mercado Pago (Suas integrações > Dados da
//                      integração > Testes > Credenciais de teste, prefixo APP_USR)
//                      Troque pelo de PRODUÇÃO quando for cobrar de verdade.

const crypto = require('crypto');

module.exports = async function handler(req, res) {
  if (req.method !== 'POST') {
    res.status(405).json({ error: 'Method Not Allowed' });
    return;
  }

  const { userId, email } = req.body || {};

  if (!userId || !email) {
    res.status(400).json({ error: 'Informe userId e email.' });
    return;
  }

  try {
    const resposta = await fetch('https://api.mercadopago.com/v1/orders', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${process.env.MP_ACCESS_TOKEN}`,
        'X-Idempotency-Key': crypto.randomUUID()
      },
      body: JSON.stringify({
        type: 'online',
        total_amount: '19.90',
        // guardamos o id do usuário do Supabase aqui pra saber quem pagou quando o webhook chegar
        external_reference: userId,
        processing_mode: 'automatic',
        transactions: {
          payments: [
            {
              amount: '19.90',
              payment_method: { id: 'pix', type: 'bank_transfer' }
            }
          ]
        },
        payer: { email }
      })
    });

    const order = await resposta.json();

    if (!resposta.ok) {
      console.error('Erro ao criar order Pix:', order);
      res.status(resposta.status).json({ error: order.message || 'Erro ao criar pagamento Pix.' });
      return;
    }

    const pagamento = order.transactions?.payments?.[0];
    const metodo = pagamento?.payment_method;

    res.status(200).json({
      orderId: order.id,
      paymentId: pagamento?.id,
      status: order.status,
      qrCode: metodo?.qr_code,             // string "copia e cola"
      qrCodeBase64: metodo?.qr_code_base64, // imagem do QR Code em base64
      ticketUrl: metodo?.ticket_url        // página pronta do Mercado Pago com QR + instruções
    });
  } catch (err) {
    console.error('Erro inesperado ao criar pagamento Pix:', err);
    res.status(500).json({ error: 'Erro interno ao criar o pagamento Pix.' });
  }
};
